# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=eventflow

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL
POSTGRESQL_URI=postgresql://eventflow_user:eventflow_password@localhost:5432/eventflow

# External Services
USUARIOS_SERVICE_URL=http://localhost:8001
EVENTOS_SERVICE_URL=http://localhost:8002

# Service Config
SERVICE_PORT=8003
SERVICE_NAME=reservas-service

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# SAGA Config
SAGA_TIMEOUT_SECONDS=30
SAGA_RETRY_ATTEMPTS=3
SAGA_RETRY_BACKOFF_BASE=0.5

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_HALF_OPEN_TIMEOUT=30

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400