# Copiar este archivo a .env y configurar valores locales

# MongoDB
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=eventflow

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# PostgreSQL
POSTGRESQL_URI=postgresql://eventflow_user:eventflow_password@postgresql:5432/eventflow

# Services URLs (para inter-service communication)
USUARIOS_SERVICE_URL=http://usuarios-service:8001
EVENTOS_SERVICE_URL=http://eventos-service:8002
RESERVAS_SERVICE_URL=http://reservas-service:8003

# App Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# API Ports (if running locally without Docker)
USUARIOS_PORT=8001
EVENTOS_PORT=8002
RESERVAS_PORT=8003
