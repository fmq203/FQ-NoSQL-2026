# Copiar este archivo a .env y configurar valores locales

# MongoDB
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DB=eventflow

# Redis transaccional (pagos e inventario de reservas)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# PostgreSQL
POSTGRESQL_URI=postgresql://eventflow_user:eventflow_password@postgresql:5432/eventflow

# Services URLs (para inter-service communication)
USUARIOS_SERVICE_URL=http://usuarios-service:8001
EVENTOS_SERVICE_URL=http://eventos-service:8002
RESERVAS_SERVICE_URL=http://reservas-service:8003

# Export anonimizado de usuarios (usuarios-service)
# Vacio = clave aleatoria por proceso (anonimizacion, seudonimos no vinculables entre reinicios).
# Con valor = seudonimos estables (seudonimizacion); custodiar la clave aparte de los datos.
EXPORT_PSEUDONYM_KEY=

# Cache de lecturas AP de usuarios/eventos (instancia aparte: redis-cache)
CACHE_REDIS_URL=redis://redis-cache:6379/0
CACHE_FRESH_SECONDS=30

# App Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# API Ports (if running locally without Docker)
USUARIOS_PORT=8001
EVENTOS_PORT=8002
RESERVAS_PORT=8003
